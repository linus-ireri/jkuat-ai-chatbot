# Required for LLM answers (Groq)
GROQ_API_KEY=

# Express RAG server port (default 3001)
PORT=3001

# Netlify functions → external RAG server (legacy Veritas.AI + WhatsApp)
RAG_SERVER_URL=http://localhost:3001

# WhatsApp (optional)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Voice I/O (optional) ─────────────────────────────────────────────────────
# Whisper model for ASR (default: Xenova/whisper-base.en, auto-downloaded on
# first use via Hugging Face Transformers).  Change to a larger model for
# higher accuracy, e.g. Xenova/whisper-small.en
WHISPER_MODEL=Xenova/whisper-base.en

# Path to the piper binary on this machine (must be on $PATH or full path).
# Leave blank to disable server-side TTS (browser falls back to speechSynthesis).
PIPER_BINARY=piper

# Full path to the .onnx model file for Piper TTS, e.g.:
#   /opt/piper/models/en_US-lessac-medium.onnx
# Download voices from: https://github.com/rhasspy/piper/releases
# Leave blank to disable server-side TTS.
PIPER_MODEL=

# Optional: override the Hugging Face model cache directory
# HF_CACHE_DIR=
